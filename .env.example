# Jo web/backend environment (example)
# Copy relevant vars into your deployment environment or .env (do not commit secrets).

# --- Primary web-chat path (recommended): OmniRoute gateway ---
# OmniRoute aggregates/routes connected & free providers behind one OpenAI-compatible endpoint.
# server/app.py prioritizes OMNIROUTE_BASE_URL for /v1/chat and /v1/chat/stream.
LLM_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_API_KEY=omniroute-local

# --- Local fallback (OpenAI-compatible, e.g. Ollama/llama.cpp server) ---
# Tried after OmniRoute (primary) for resilient, always-on responses.
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_API_KEY=sk-local

# --- Direct provider fallbacks (safety net after OmniRoute/local) ---
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
DOUBLEWORD_API_KEY=

# Model hints used by ouroboros/agent stack (web backend primarily uses OmniRoute/local chain)
OUROBOROS_MODEL=openrouter/free
OUROBOROS_MODEL_CODE=
OUROBOROS_MODEL_LIGHT=

# Web backend options
JO_WEB_USE_AGENT=0
DATA_ROOT=/home/jo/.jo_data
REPO_DIR=/home/jo/workspace/projects/jo
OUROBOROS_DETERMINISTIC=1
OUROBOROS_LLM_TEMPERATURE=0
