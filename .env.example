# Jo web/backend environment (example)
# Copy relevant vars into your deployment environment or .env (do not commit secrets).

# --- OmniRoute-only backend/gateway ---
# server/app.py and web backend workflows use OmniRoute as the sole model source.
LLM_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_API_KEY=omniroute-local

# --- Web/backend runtime options ---
JO_WEB_USE_AGENT=0
DATA_ROOT=/home/jo/.jo_data
REPO_DIR=/home/jo/workspace/projects/jo
OUROBOROS_DETERMINISTIC=1
OUROBOROS_LLM_TEMPERATURE=0
