# Jo OpenAI hybrid migration
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_MODEL_CODE=gpt-5.6-sol
OPENAI_MODEL_LIGHT=gpt-5.6-luna
OPENAI_MODEL_REASONING=gpt-5.6-sol
OPENAI_TIMEOUT_SEC=90

# Existing Jo services remain required for their respective features:
# TELEGRAM_BOT_TOKEN=
# GITHUB_TOKEN=
# GITHUB_USER=
# GITHUB_REPO=
# TOTAL_BUDGET=

# MCP gateway (enable only after local validation)
JO_MCP_HOST=127.0.0.1
JO_MCP_PORT=8000
JO_MCP_AUTH_TOKEN=
JO_MCP_ALLOW_ANONYMOUS=0
JO_MCP_ALLOW_WRITE=0
JO_MCP_REPO_DIR=
JO_MCP_DATA_ROOT=
