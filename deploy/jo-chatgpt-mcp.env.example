# ChatGPT MCP bridge
# No OpenAI API key is required for this MCP-only architecture.

JO_FREE_ONLY=1

JO_MCP_REPO_DIR=/opt/jo
JO_MCP_DATA_ROOT=/opt/jo-data
JO_MCP_HOST=127.0.0.1
JO_MCP_PORT=8000

# Required unless JO_MCP_ALLOW_ANONYMOUS=1 (local development only)
JO_MCP_AUTH_TOKEN=

JO_MCP_ALLOW_ANONYMOUS=0
JO_MCP_ALLOW_WRITE=0
JO_MCP_SERVER_NAME=Jo

# Optional exact tool allowlist. When set, it overrides default read/write sets.
# JO_MCP_TOOL_ALLOWLIST=repo_read,repo_list,git_status,git_diff,vault_search
