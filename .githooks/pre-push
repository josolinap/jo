#!/bin/bash
# Pre-push hook — validates code before allowing push
# Installed via: git config core.hooksPath .githooks
#
# Checks:
# 1. Python syntax (py_compile on all modules)
# 2. Critical imports resolve
# 3. Smoke tests pass (test_smoke.py)
# 4. Full test suite passes (if OUROBOROS_PRE_PUSH_TESTS != "0")
# 5. Coherence audit (if coherence_audit_tool available)
#
# Bypass: git push --no-verify

set -e

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
    echo "PRE-PUSH: Cannot find repo root" >&2
    exit 1
fi

cd "$REPO_ROOT"

echo "=== Pre-push validation ==="

# Detect Python
if command -v python3 &> /dev/null; then
    PYTHON="python3"
elif command -v python &> /dev/null; then
    PYTHON="python"
else
    echo "✗ No Python interpreter found"
    exit 1
fi

# 1. Syntax check
echo "1. Checking Python syntax..."
$PYTHON -m py_compile ouroboros/*.py 2>/dev/null && echo "  ✓ ouroboros/*.py" || { echo "  ✗ Syntax errors in ouroboros/*.py"; exit 1; }
$PYTHON -m py_compile ouroboros/tools/*.py 2>/dev/null && echo "  ✓ ouroboros/tools/*.py" || { echo "  ✗ Syntax errors in ouroboros/tools/*.py"; exit 1; }
$PYTHON -m py_compile supervisor/*.py 2>/dev/null && echo "  ✓ supervisor/*.py" || { echo "  ✗ Syntax errors in supervisor/*.py"; exit 1; }

# 2. Critical imports
echo "2. Checking critical imports..."
$PYTHON -c "from ouroboros.tools.registry import ToolRegistry" 2>/dev/null && echo "  ✓ ToolRegistry" || { echo "  ✗ ToolRegistry import failed"; exit 1; }
$PYTHON -c "from ouroboros.vault_manager import VaultManager" 2>/dev/null && echo "  ✓ VaultManager" || { echo "  ✗ VaultManager import failed"; exit 1; }
$PYTHON -c "from supervisor.state import init" 2>/dev/null && echo "  ✓ supervisor.state" || { echo "  ✗ supervisor.state import failed"; exit 1; }
$PYTHON -c "from ouroboros.memory import Memory" 2>/dev/null && echo "  ✓ Memory" || { echo "  ✗ Memory import failed"; exit 1; }
$PYTHON -c "from ouroboros.context import build_llm_messages" 2>/dev/null && echo "  ✓ context" || { echo "  ✗ context import failed"; exit 1; }

# 3. Smoke tests (always run — fast and critical)
echo "3. Running smoke tests..."
export PYTHONPATH="${PYTHONPATH}:${REPO_ROOT}"
$PYTHON -m pytest tests/test_smoke.py -q --tb=short 2>&1 | tail -3 || { echo "  ✗ Smoke tests failed"; exit 1; }
echo "  ✓ Smoke tests passed"

# 4. Full test suite (skip if OUROBOROS_PRE_PUSH_TESTS=0, e.g. in CI)
if [ "${OUROBOROS_PRE_PUSH_TESTS:-1}" != "0" ]; then
    echo "4. Running full test suite..."
    $PYTHON -m pytest tests/ -q --tb=short 2>&1 | tail -3 || { echo "  ✗ Tests failed"; exit 1; }
    echo "  ✓ All tests passed"
else
    echo "4. Full test suite skipped (OUROBOROS_PRE_PUSH_TESTS=0)"
fi

# 5. Version sync check
echo "5. Checking version sync..."
$PYTHON -c "
from pathlib import Path
import re
v = Path('VERSION').read_text().strip()
pyproject = Path('pyproject.toml').read_text()
match = re.search(r'version\s*=\s*\"([^\"]+)\"', pyproject)
assert match, 'version not in pyproject.toml'
assert v == match.group(1), f'VERSION={v} != pyproject={match.group(1)}'
readme = Path('README.md').read_text()
assert v in readme, f'VERSION={v} not in README'
print(f'  ✓ Version sync ({v})')
" || exit 1

# 6. Protected files check
echo "6. Checking protected files..."
$PYTHON -c "
from pathlib import Path
protected = Path('.jo_protected').read_text()
missing = []
for line in protected.split('\n'):
    line = line.strip()
    if not line or line.startswith('#'):
        continue
    if not Path(line).exists():
        missing.append(line)
if missing:
    print(f'  ✗ Missing protected files: {missing}')
    exit(1)
print(f'  ✓ All protected files exist')
" || exit 1

echo ""
echo "✅ Pre-push validation passed — all checks OK"
